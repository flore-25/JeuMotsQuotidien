# Copy to .env.local (git-ignored) and fill in from Supabase: Project Settings → API.
# The first two are public values (they ship to the browser).
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx

# Only for `npm run upload` (puzzles → Supabase). SECRET: bypasses all security rules.
# Never used by the site build, never sent to the browser, never commit it, never paste it in a chat.
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxxxxxx
